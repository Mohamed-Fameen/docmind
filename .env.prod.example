# Copy to .env (same directory as docker-compose.prod.yml) and fill in real values.
# docker-compose.prod.yml's ${VAR:?message} syntax will refuse to start if any of the
# required ones below are left unset — a deliberate safeguard against accidentally running
# with the insecure local-dev defaults (dev-only-insecure-secret-change-me, docmind_dev) in
# anything reachable from the internet.

# A long, random string — never reuse the local dev value.
JWT_SECRET_KEY=

# A real password — never reuse the local dev value (docmind_dev).
POSTGRES_PASSWORD=

# AWS credentials for Bedrock generation. Prefer an IAM role instead of long-lived keys if
# this ever runs on actual AWS infra (EC2/ECS/Fargate) rather than an arbitrary VPS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Wherever the backend will actually be reachable once deployed — NOT localhost. If backend
# and frontend run on the same VPS, this is likely http://<your-server-ip>:8000 or a real
# domain once you set one up with a reverse proxy (see docs/09-deployment.md).
NEXT_PUBLIC_API_URL=

# Which frontend origin the backend allows via CORS. MUST match the frontend's real URL
# exactly (scheme + host + port).
CORS_ALLOWED_ORIGINS=

# Which frontend origin the backend allows via CORS. MUST match the frontend's real URL
# exactly (scheme + host + port).
CORS_ALLOWED_ORIGINS=
