# --- Generation model selection ---
# Which entry in backend/app/config.py's MODEL_REGISTRY to use by default when a /query
# request doesn't specify one. Override per-request via the "model" field in the request body.
ACTIVE_MODEL=llama3.2-3b-local

# --- Local LLM (Ollama) ---
# 3B model is the default — fits alongside the embedding model + reranker on an RTX 3050's
# VRAM. An 8B local model will likely OOM once all three are loaded simultaneously; use the
# claude-bedrock registry entry instead for larger-model comparisons.
OLLAMA_HOST=http://localhost:11434
# Forces Ollama to generate on CPU instead of GPU. Defaults true because even a 3B model
# OOM'd alongside the embedding model + reranker on a small (~4GB) GPU in real testing —
# there was no VRAM left at all once the encoder models were loaded. Set to false if you
# have more VRAM headroom.
OLLAMA_FORCE_CPU=true

# --- Hosted LLM (AWS Bedrock) ---
# Credentials are picked up automatically by boto3 (environment variables, ~/.aws/credentials,
# or an IAM role) — no key goes in this file. Just set the region and model ID.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# Check https://docs.aws.amazon.com/bedrock/latest/userguide/models-supported.html for the
# current list of available model IDs before relying on the default above — it may be stale.

# --- Direct Anthropic/OpenAI API (not currently used by llm.py, kept for future use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Vector DB (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=k8s_docs

# --- Embeddings / Reranker ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDING_DEVICE=cuda        # cuda | cpu  (use cuda for your RTX 3050)

# --- Redis (session memory) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Postgres (chat history / auth) ---
POSTGRES_DSN=postgresql://docmind:docmind_dev@localhost:5432/docmind

# --- JWT auth (Phase 6) ---
# CHANGE THIS for anything beyond local dev — a long random secret, never committed.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=1440
