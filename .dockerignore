# Local dev artifacts that shouldn't be copied into the backend image
.venv/
__pycache__/
*.pyc
.env
.git/
.gitignore

# Raw corpus (14.8MB, only needed during Phase 1-3 ingestion, not at runtime — the
# processed chunks.jsonl is what actually gets copied into the image, see Dockerfile)
data/raw/

# Frontend has its own separate build (own Dockerfile, own .dockerignore)
frontend/node_modules/
frontend/.next/

# Local logs — shouldn't ship with the image, and will be regenerated at runtime anyway
data/logs/

eval/results.json
